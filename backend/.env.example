# Backend Environment Variables

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# Connection string format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://codetracex_user:codetracex_dev_password@localhost:5432/codetracex

# PostgreSQL connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Repository Analysis Limits
# Maximum repository download size in megabytes
# Default: 500MB (prevents excessive disk usage and processing time)
MAX_REPOSITORY_SIZE_MB=500

# Maximum number of files to scan in a repository
# Default: 10000 (prevents pathological repositories from consuming unlimited resources)
MAX_REPOSITORY_FILES=10000

# Embeddings Configuration
# Embedding provider (sentence-transformers, openai)
EMBEDDING_PROVIDER=sentence-transformers

# Embedding model name
# For sentence-transformers: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
# For openai: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Embedding vector dimension (must match the model)
# all-MiniLM-L6-v2: 384
# all-mpnet-base-v2: 768
# text-embedding-3-small: 1536
EMBEDDING_DIMENSION=384

# Maximum content length for embeddings (characters)
# Content longer than this will be truncated
MAX_EMBEDDING_CONTENT_LENGTH=2000

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=32

# LLM Configuration (Phase 12: LLM Reasoning)
# LLM provider (gemini, openai - only gemini implemented currently)
LLM_PROVIDER=gemini

# LLM model name
# For Gemini: gemini-1.5-flash (faster, cheaper), gemini-1.5-pro (more capable)
LLM_MODEL=gemini-1.5-flash

# LLM API key (required for LLM features)
# For Gemini: Get from https://makersuite.google.com/app/apikey
# SECURITY: Never commit this key to version control
LLM_API_KEY=your-api-key-here

# LLM request timeout in seconds
LLM_TIMEOUT=60

# LLM temperature (0.0-1.0, lower = more deterministic)
# Default: 0.1 for grounded, factual answers
LLM_TEMPERATURE=0.1

# Maximum tokens to generate
LLM_MAX_TOKENS=4096

# Background Jobs Configuration (Phase 14)
# Redis URL for job queue
# Format: redis://host:port/db
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Number of concurrent workers to run
# Default: 2 (adjust based on CPU cores and workload)
WORKER_CONCURRENCY=2

# Maximum concurrent repository analysis jobs
# Default: 2 (prevents resource exhaustion)
MAX_CONCURRENT_ANALYSIS_JOBS=2

# Job timeout in seconds
# Default: 3600 (1 hour)
# Increase for very large repositories
JOB_TIMEOUT=3600

# Job result TTL (time-to-live) in seconds
# How long job results are kept in Redis after completion
# Default: 86400 (24 hours)
JOB_RESULT_TTL=86400
